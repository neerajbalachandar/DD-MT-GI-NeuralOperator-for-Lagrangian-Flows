{
  "seed": 42,
  "device": "auto",
  "data": {
    "dataset": "processed_data/leapfrogging/particle_evolution_dataset.npz",
    "merged_frames": "processed_data/leapfrogging/merged_frames",
    "native_task2_root": "datagen_code/training_data",
    "allow_missing_native_task2": false,
    "input_features": [
      "x",
      "y",
      "z",
      "Gamma_x",
      "Gamma_y",
      "Gamma_z",
      "sigma",
      "u_x",
      "u_y",
      "u_z",
      "gradU_xx",
      "gradU_xy",
      "gradU_xz",
      "gradU_yx",
      "gradU_yy",
      "gradU_yz",
      "gradU_zx",
      "gradU_zy",
      "gradU_zz",
      "phase",
      "delta_t"
    ],
    "global_condition_channels": [
      "freestream_magnitude",
      "phase"
    ],
    "max_particles": 2048,
    "max_queries": 32768
  },
  "preprocessing": {
    "max_rss_gb": 32
  },
  "model": {
    "latent_res": 16,
    "hidden_channels": 128,
    "fno_layers": 6,
    "fno_modes": 6,
    "gno_radius": 0.15,
    "mlp_layers": 3,
    "mlp_hidden": 128,
    "query_pos_encoding_frequencies": 4,
    "use_attention": true,
    "use_skip": true,
    "use_global_conditioning": true,
    "use_task_adapters": true,
    "predict_delta_u": true
  },
  "training": {
    "run_dir": "runs/leapfrogging_rollout",
    "init_checkpoint": "runs/leapfrogging_pretrain/best_model.pt",
    "epochs": 100,
    "gradient_accumulation_steps": 4,
    "dataloader_num_workers": 8,
    "validation_every_n_epochs": 1,
    "learning_rate": 2e-05,
    "weight_decay": 3e-05,
    "scheduler": "plateau",
    "grad_clip_norm": 0.5,
    "early_stopping_patience": 25,
    "mixed_precision": false,
    "use_state_loss": true,
    "use_field_loss": true,
    "use_rollout_loss": true,
    "use_pushforward": true,
    "use_scheduled_sampling": false,
    "use_gns_noise": false,
    "use_homoscedastic_weighting": false,
    "state_loss_weight": 1.0,
    "field_loss_weight": 1.0,
    "field_velocity_weight": 1.0,
    "field_gradient_weight": 0.5,
    "field_vorticity_weight": 0.1,
    "use_relative_l2_field_loss": true,
    "rollout_weight": 0.05,
    "pushforward_weight": 0.05,
    "rollout_horizon_max": 32,
    "rollout_horizon_schedule": [
      2,
      4,
      8,
      16,
      24,
      32,
      32,
      32
    ],
    "validation_rollout_horizon": 32
  },
  "evaluation": {
    "checkpoint": "",
    "split": "test",
    "rollout_horizons": [
      1,
      4,
      8,
      16,
      32,
      64,
      180
    ],
    "rollout_starts_per_case": 5,
    "max_batches": 0,
    "allow_missing_native_task2": true,
    "save_plots": true,
    "save_full_fields": true,
    "save_full_rollout_fields": true,
    "field_visual_phase": 0.5,
    "field_visual_phases": [
      0.1,
      0.3,
      0.5,
      0.7,
      0.9
    ],
    "field_plane_mode": "highest_energy",
    "save_parity_plots": true,
    "save_field_groups": true
  }
}